<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/creatorflow-io/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_PACKAGE_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGE_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <!-- Central package management needs a mapping once there are two sources. Packages come from nuget.org; the GitHub
       feed is where CI pushes alpha and beta packages (shared-pack) and serves only Juice packages. Juice is listed under
       both: the most specific pattern wins, so without it here a stable Juice release on nuget.org could never be found. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Juice.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Juice.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
