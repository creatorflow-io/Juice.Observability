<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform API (/api/v1, requirements §6.1) and the platform's background workers, as a library: a host adds them
       with AddJuiceObservability and MapJuiceObservability (src/Juice.Observability.Host is the reference host). -->
  <PropertyGroup>
    <Description>Juice Observability platform API (/api/v1) and its discovery, health, rule and webhook workers, for an ASP.NET Core host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <!-- the implicit usings of Microsoft.NET.Sdk.Web, which this project was -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Observability.Data\Juice.Observability.Data.csproj" />
    <ProjectReference Include="..\Juice.Observability.Discovery\Juice.Observability.Discovery.csproj" />
    <ProjectReference Include="..\Juice.Observability.Health\Juice.Observability.Health.csproj" />
    <ProjectReference Include="..\Juice.Observability.Rules\Juice.Observability.Rules.csproj" />
    <ProjectReference Include="..\Juice.Observability.Webhooks\Juice.Observability.Webhooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Juice.Observability.Tests" />
  </ItemGroup>

</Project>
