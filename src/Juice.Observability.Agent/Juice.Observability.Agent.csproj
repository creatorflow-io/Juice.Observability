<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Juice Agent (roadmap Phase 7): runs on a host, connects only outbound, over mTLS, and runs only the read-only actions its local
       allowlist permits, after checking each signed command itself. Shipped as a program, not a package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>juice-agent</AssemblyName>
    <RootNamespace>Juice.Observability.Agent</RootNamespace>
    <UserSecretsId>juice-agent</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Observability.Agent.Contracts\Juice.Observability.Agent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Juice.Observability.Tests" />
  </ItemGroup>

  <!-- manifest.json beside the program: its version, as packages and the launcher name it, and what to start. -->
  <Target Name="AgentManifest" BeforeTargets="AssignTargetPaths">
    <WriteLinesToFile File="$(IntermediateOutputPath)manifest.json" Lines="{&quot;version&quot;:&quot;$(Version)&quot;,&quot;entryPoint&quot;:&quot;$(AssemblyName).dll&quot;}" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
