<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Juice Agent (roadmap Phase 7): runs on a host, connects only outbound, over mTLS, and runs only the actions its local allowlist permits,
       after checking each signed command itself. A program, and a package for building your own agent with custom actions
       (AgentAction<TParameters>, JuiceAgent.RunAsync). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>juice-agent</AssemblyName>
    <PackageId>Juice.Observability.Agent</PackageId>
    <RootNamespace>Juice.Observability.Agent</RootNamespace>
    <UserSecretsId>juice-agent</UserSecretsId>
    <Description>Juice Agent: a host's outbound, mTLS agent for Juice Observability. Reference it from your own program to add custom actions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Observability.Agent.Contracts\Juice.Observability.Agent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Juice.Observability.Tests" />
  </ItemGroup>

  <!-- The manifest step, for this program and, from the package, for a customer's own agent program. -->
  <Import Project="msbuild\Juice.Observability.Agent.targets" />
  <ItemGroup>
    <None Include="msbuild\Juice.Observability.Agent.targets" Pack="true" PackagePath="build\;buildTransitive\" />
  </ItemGroup>

</Project>
