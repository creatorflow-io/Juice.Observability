<Project Sdk="Microsoft.NET.Sdk">

  <!-- The notification pipeline of Juice.Notifications, embedded in the platform's host (phase 5, M45): its registration on the platform's
       PostgreSQL and tenant, the platform's transaction as the pipeline's, and (with the adapter) alert transitions, acknowledgements and
       action requests as notification requests. -->
  <PropertyGroup>
    <Description>Juice Observability on the Juice Notifications pipeline: the embedded registration and the platform's transaction for it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Juice.Notifications.Abstractions" />
    <PackageReference Include="Juice.Notifications.Embedded" />
    <PackageReference Include="Juice.Notifications.Providers.Chat" />
  </ItemGroup>

  <ItemGroup>
    <!-- The platform's own rules for what a transition sends, silences and held notifications (NotificationPlan, SilenceMatcher,
         HeldNotification) and the action request notice, shared with the webhooks until M50 moves them. -->
    <ProjectReference Include="..\Juice.Observability.Webhooks\Juice.Observability.Webhooks.csproj" />
    <ProjectReference Include="..\Juice.Observability.Agents\Juice.Observability.Agents.csproj" />
    <!-- The dead-man's shadow cause (M49's IShadowReport), which the comparer's report answers. -->
    <ProjectReference Include="..\Juice.Observability.Health\Juice.Observability.Health.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Juice.Observability.Tests" />
  </ItemGroup>

</Project>
