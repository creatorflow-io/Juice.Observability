<Project Sdk="Microsoft.NET.Sdk">

  <!-- PostgreSQL domain model (requirements §6): tenant, applications, environments, services, instances, resources,
       dependencies, audit records and reconciliation checkpoints. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- one EF Core version for the design-time tools and every consumer -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- The context is the mediator's unit of work and holds the outbox (Juice TransactionBehavior). -->
    <PackageReference Include="Juice.MediatR.Behaviors" />
    <PackageReference Include="Juice.Messaging.Outbox.EF" />
  </ItemGroup>

</Project>
