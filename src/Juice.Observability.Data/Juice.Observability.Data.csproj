<Project Sdk="Microsoft.NET.Sdk">

  <!-- PostgreSQL domain model (requirements §6): tenant, applications, environments, services, instances, resources,
       dependencies, audit records and reconciliation checkpoints. -->
  <ItemGroup>
    <!-- Leased-worker, event and module-data contracts (core 2.0 M2). -->
    <ProjectReference Include="..\Juice.Observability.Extensibility\Juice.Observability.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- one EF Core version for the design-time tools and every consumer -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- The context is the mediator's unit of work and holds the outbox (Juice TransactionBehavior). -->
    <PackageReference Include="Juice.MediatR.Behaviors" />
    <PackageReference Include="Juice.Messaging.Outbox.EF" />
  </ItemGroup>

  <!-- The core's own assemblies, which raise events for modules (IPlatformEventPublisher): a module can't name it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Juice.Observability.Discovery" />
    <InternalsVisibleTo Include="Juice.Observability.Rules" />
    <InternalsVisibleTo Include="Juice.Observability.Slos" />
    <InternalsVisibleTo Include="Juice.Observability.Api" />
    <InternalsVisibleTo Include="Juice.Observability.Tests" />
  </ItemGroup>

</Project>
