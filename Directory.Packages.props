<Project>
  <ItemGroup>
    <PackageVersion Include="ClickHouse.Driver" Version="1.5.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- The mediator's TransactionBehavior and the outbox: alert transitions reach notifications through them. -->
    <PackageVersion Include="Juice.EF" Version="10.13.1" />
    <PackageVersion Include="Juice.MediatR" Version="10.13.1" />
    <PackageVersion Include="Juice.MediatR.Behaviors" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Idempotency.Caching" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Local" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Outbox.Delivery" Version="10.13.1" />
    <PackageVersion Include="Juice.Messaging.Outbox.EF" Version="10.13.1" />
    <!-- The notification pipeline, embedded (phase 5, M45): published alphas of Juice.Notifications only, pinned exactly; one person bumps them. -->
    <PackageVersion Include="Juice.Notifications.Abstractions" Version="0.1.0-alpha.64" />
    <PackageVersion Include="Juice.Notifications.Embedded" Version="0.1.0-alpha.64" />
    <PackageVersion Include="Juice.Notifications.Admin" Version="0.1.0-alpha.64" />
    <PackageVersion Include="Juice.Notifications.Inbox" Version="0.1.0-alpha.64" />
    <PackageVersion Include="Juice.Notifications.Providers.Chat" Version="0.1.0-alpha.64" />
    <!-- Email channels: reports a refused login and the server's codes, which System.Net.Mail loses (Gmail closes after a 535). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Tests only: a session on the inbox hub (M54). -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The platform's own metrics (Phase 11): the SDK and its OTLP exporter. ASP.NET Core, HttpClient, the runtime and Npgsql publish
         their metrics themselves (.NET 10), so no instrumentation packages. -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
