<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests, and integration tests against the running deploy/local stack (skipped when it is not running). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- EF queries in assertions need no cancellation token -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Juice.Observability.Api\Juice.Observability.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
