<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests, and integration tests against the running deploy/local stack (skipped when it is not running). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- EF queries in assertions need no cancellation token -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The platform's own metrics, read back in tests (PlatformMetricsTests). -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Juice.Observability.Host\Juice.Observability.Host.csproj" />
    <ProjectReference Include="..\..\src\Juice.Observability.Agent\Juice.Observability.Agent.csproj" />
    <ProjectReference Include="..\..\src\Juice.Observability.Agent.Launcher\Juice.Observability.Agent.Launcher.csproj" />
    <!-- Phase 5 M46: the legacy webhook setup's mapping onto notifications, its templates and the migration tool. -->
    <ProjectReference Include="..\..\src\Juice.Observability.Notifications.Migration\Juice.Observability.Notifications.Migration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
