<Project>
  <PropertyGroup Label="Product Information">
    <Company>Creatorflow.io</Company>
    <Product>Juice Observability</Product>
    <Copyright>© $(Company). All rights reserved.</Copyright>
    <Authors>$(Company)</Authors>
    <Description>$(Product): discovery, health, rules and alerts over OpenTelemetry for Juice services.</Description>
    <PackageTags>$(PackageTags); $(Company); Juice; Observability; OpenTelemetry</PackageTags>
    <RepositoryUrl>https://github.com/creatorflow-io/Juice.Observability</RepositoryUrl>

    <!-- CI sets the suffix (alpha.N, beta.N) or, for a release, the whole version from the release tag -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>local.$([System.DateTime]::Now.ToString(`yyyyMMdd`)).1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Build output outside the source tree -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)build/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- Packages: every project under src/ (a host opts out); never the tests -->
  <PropertyGroup Label="Packaging">
    <IsPackable Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">true</IsPackable>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <PackageOutputPath>$(MSBuildThisFileDirectory)build/packages/</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
