{
  "realm": "juice",
  "displayName": "Juice Observability (local)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GRAFANA_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://${PUBLIC_HOST}:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/login/generic_oauth",
        "http://${PUBLIC_HOST}:3000/login/generic_oauth"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://${PUBLIC_HOST}:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/login##http://${PUBLIC_HOST}:3000/login"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "grafana roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "grafana",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "juice-platform",
      "name": "Juice Observability Platform API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "juice-platform-cli",
      "name": "Platform API tokens for local development and tests",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email",
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "platform audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "juice-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "platform roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "juice-platform",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "platform tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "platform_tenant",
            "claim.value": "${JUICE_PLATFORM_TENANT_ID}",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "juice-console",
      "name": "Juice Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://${PUBLIC_HOST}:5180",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5180/*",
        "http://${PUBLIC_HOST}:5180/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:5180",
        "http://${PUBLIC_HOST}:5180",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5180/*##http://${PUBLIC_HOST}:5180/*##http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "platform audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "juice-platform",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "platform roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "juice-platform",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "platform tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "platform_tenant",
            "claim.value": "${JUICE_PLATFORM_TENANT_ID}",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "console roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "juice-platform",
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    }
  ],
  "roles": {
    "client": {
      "grafana": [
        {
          "name": "admin",
          "description": "Grafana Admin of the Juice organization"
        },
        {
          "name": "editor",
          "description": "Grafana Editor"
        },
        {
          "name": "viewer",
          "description": "Grafana Viewer"
        }
      ],
      "juice-platform": [
        {
          "name": "admin",
          "description": "Platform administrator"
        },
        {
          "name": "operator",
          "description": "Acknowledges alerts"
        },
        {
          "name": "viewer",
          "description": "Reads inventory, health and alerts"
        }
      ]
    }
  },
  "users": [
    {
      "id": "5f1c2a10-0000-4000-8000-00000000a11c",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@juice.local",
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "grafana": [
          "admin"
        ],
        "juice-platform": [
          "admin"
        ]
      }
    },
    {
      "id": "5f1c2a10-0000-4000-8000-0000000e5140",
      "username": "erin",
      "enabled": true,
      "emailVerified": true,
      "email": "erin@juice.local",
      "firstName": "Erin",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "grafana": [
          "editor"
        ],
        "juice-platform": [
          "operator"
        ]
      }
    },
    {
      "id": "5f1c2a10-0000-4000-8000-0000000f1c70",
      "username": "victor",
      "enabled": true,
      "emailVerified": true,
      "email": "victor@juice.local",
      "firstName": "Victor",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "grafana": [
          "viewer"
        ],
        "juice-platform": [
          "viewer"
        ]
      }
    },
    {
      "id": "5f1c2a10-0000-4000-8000-000000000a0a",
      "username": "nora",
      "enabled": true,
      "emailVerified": true,
      "email": "nora@juice.local",
      "firstName": "Nora",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "grafana": [
      {
        "client": "grafana",
        "roles": [
          "admin",
          "editor",
          "viewer"
        ]
      }
    ],
    "juice-platform": [
      {
        "client": "juice-platform-cli",
        "roles": [
          "admin",
          "operator",
          "viewer"
        ]
      },
      {
        "client": "juice-console",
        "roles": [
          "admin",
          "operator",
          "viewer"
        ]
      }
    ]
  }
}
